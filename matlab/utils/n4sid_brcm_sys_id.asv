%% Rigorous System Identification & Benchmarking for EMPC
clear; clc; close all;

% --- 1. Configuration & Data Loading ---
% Load the exact splits generated by the Python DataModule
load('../../data/system_id_data.mat'); % Contains u_train, y_train, u_val, y_val, Ts
Ts = double(Ts);

% Parameters matching PyTorch setup
K_horizon = 96;      % Match datamodule's max_horizon for strict comparison
orders = 5:10T;      % Sweep state dimensions (your PyTorch latent size equivalent)

ze = iddata(y_train, u_train, Ts, 'TimeUnit', 'minutes');
zv = iddata(y_val, u_val, Ts, 'TimeUnit', 'minutes');

%% NLS

% Assume you already have:
% y: column vector of zone air temp
% u: [Q_heat, T_amb, Q_solar]
% Ts: sample time in seconds or minutes (consistent with your ODE scaling)

data = iddata(y, u, Ts, 'Name', '1-zone room');

FileName = 'onezone_2RC'; % model file
Order    = [2 1 1];       % [numStates numInputs numOutputs]

% Initial parameter guesses (choose reasonable values)
Parameters = [
    1e5;   % C_a
    5e5;   % C_m
    0.5;   % R_oa
    0.1;   % R_am
    0.8;   % alpha_h
    0.2    % alpha_s
];

% Initial states (e.g. first measurement)
x0 = [y(1); y(1)];

init_sys = idnlgrey(FileName, Order, Parameters, x0, Ts, ...
    'Name', '1-zone 2RC');

% Optional: fix some parameters or set bounds
init_sys.Parameters(1).Minimum = 1e3;
init_sys.Parameters(2).Minimum = 1e4;
init_sys.Parameters(3).Minimum = 1e-3;
init_sys.Parameters(4).Minimum = 1e-3;

%% SUBSPACE
% Output names for plotting
ze.OutputName = {'Zone 1', 'Zone 2', 'Zone 3', 'Zone 4', 'Zone 5'};
zv.OutputName = ze.OutputName;

% --- 2. Model Order Sweep ---
num_orders = length(orders);
val_sim_fit   = zeros(num_orders, 1);
val_k_rmse    = zeros(num_orders, 1);
aic_vals      = zeros(num_orders, 1);
models        = cell(num_orders, 1);

fprintf('Sweeping model orders %d to %d...\n', orders(1), orders(end));

% Common options for multi-step objective
opt_n4 = n4sidOptions('Focus', 'simulation', 'Display', 'off');
opt_ss = ssestOptions('Focus', 'simulation', 'Display', 'off');

for i = 1:num_orders
    nx = orders(i);
    
    % Initialize globally with subspace, then refine with non-linear PEM
    sys_init = n4sid(ze, nx, 'Feedthrough', false, opt_n4);
    sys_opt  = ssest(ze, sys_init, opt_ss);
    models{i} = sys_opt;
    
    % Metric A: Akaike Information Criterion (Training Data)
    aic_vals(i) = sys_opt.Report.Fit.AIC;
    
    % Metric B: Infinite-step Simulation Fit (Validation Data)
    [~, sim_fit_array, ~] = compare(zv, sys_opt);
    val_sim_fit(i) = mean(sim_fit_array); % Mean across 5 zones
    
    % Metric C: K-step ahead Prediction RMSE (Direct PyTorch Comparison)
    % This replicates the TrajectoryBatch prediction horizon
    yp_k = predict(sys_opt, zv, K_horizon);
    err_k = zv.OutputData - yp_k.OutputData;
    val_k_rmse(i) = mean(sqrt(mean(err_k.^2, 1))); % Mean RMSE across zones
    
    fprintf('Order %2d | AIC: %6.1f | Sim Fit: %5.2f%% | %d-step RMSE: %5.4f\n', ...
            nx, aic_vals(i), val_sim_fit(i), K_horizon, val_k_rmse(i));
end

% --- 3. Select Optimal Model ---
% For EMPC, the K-step RMSE or Simulation Fit on validation data is the gold standard.
[~, best_idx] = min(val_k_rmse); 
best_order = orders(best_idx);
best_sys = models{best_idx};

fprintf('\n=== Optimal Model Selected: Order %d ===\n', best_order);

% --- 4. Publication-Ready Plots ---
% Aesthetics
set(groot, 'defaultLineLineWidth', 1.5);
set(groot, 'defaultAxesFontSize', 12);
set(groot, 'defaultAxesGridColor', [0.8 0.8 0.8]);

%% Figure 1: Order Selection Analysis (Elbow Curve & AIC)
figure('Name', 'Model Order Selection', 'Position', [100, 100, 800, 400]);

yyaxis left
plot(orders, val_sim_fit, '-o', 'MarkerSize', 6, 'MarkerFaceColor', 'b');
ylabel('Validation Simulation Fit (%)');
ylim([max(0, min(val_sim_fit)-5), 100]);

yyaxis right
plot(orders, aic_vals, '-s', 'MarkerSize', 6, 'MarkerFaceColor', 'r');
ylabel('Akaike Information Criterion (AIC)');
xlabel('Model Order (State Dimension, n_x)');
title('Model Complexity vs. Validation Performance');
grid on;
xline(best_order, '--k', 'Best K-step Model', 'LabelVerticalAlignment', 'bottom');

%% Figure 2: K-Step Trajectory Tracking (PyTorch Benchmark)
% Zoom in on a specific 48-hour window in the validation set (48h = 192 samples)
window_start = 100; 
window_end = window_start + 192;
t_vec = (0:(window_end - window_start - 1)) * (double(Ts) / 60); % Hours

% Generate predictions for best system
yp_best = predict(best_sys, zv, K_horizon);

figure('Name', sprintf('%d-Step Ahead Prediction', K_horizon), 'Position', [150, 150, 1000, 600]);
sgtitle(sprintf('%d-Step Ahead (%.2f hours) Prediction vs. Ground Truth on Validation Set', ...
        K_horizon, K_horizon*Ts/60), 'FontSize', 14, 'FontWeight', 'bold');

for z = 1:5
    subplot(5, 1, z);
    plot(t_vec, zv.OutputData(window_start:window_end-1, z), 'k-', 'DisplayName', 'True');
    hold on;
    plot(t_vec, yp_best.OutputData(window_start:window_end-1, z), 'b--', 'DisplayName', 'LTI Model');
    ylabel(sprintf('Zone %d', z));
    grid on;
    if z == 1
        legend('Location', 'northeast');
    end
    if z == 5
        xlabel('Time (Hours)');
    end
end

%% Figure 3: Residual Analysis (Whiteness Test)
% Rigorous check: residuals should be uncorrelated with inputs (no unmodeled dynamics)
figure('Name', 'Residual Analysis', 'Position', [200, 200, 800, 500]);
resid(zv, best_sys);
title(sprintf('Residual Cross-Correlation (Optimal Order = %d)', best_order));

% --- 5. Export Best Model for EMPC / Python ---
% Extract LTI matrices to pass to your CVXPY / JAX controller
A = best_sys.A;
B = best_sys.B;
C = best_sys.C;
D = best_sys.D;

save('optimal_lti_matrices.mat', 'A_opt', 'B_opt', 'C_opt', 'D_opt', 'best_order', 'Ts');
disp('Saved optimal LTI matrices to optimal_lti_matrices.mat');

%%
eig(A)